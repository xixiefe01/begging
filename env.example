/* ============================================================
   Agnes API 配置文件 —— 复制本文件为 env.js 并填入你的 Key
   ------------------------------------------------------------
   使用步骤:
   1. 把本文件复制一份,重命名为 env.js
   2. 在 AGNES_API_KEY 引号里填入你的 Agnes API Key
   3. 保存,刷新浏览器即可
   ------------------------------------------------------------
   没有 Key? 去 https://agnes-ai.com 注册申请
   ============================================================ */

window.__ENV__ = {
  // 👇 在引号里填你的 Agnes API Key(必填)
  AGNES_API_KEY: "",

  // Agnes API 基础地址(走本地代理,无需修改)
  AGNES_API_BASE_URL: "/v1",

  // 使用的模型(可选,默认 agnes-2.0-flash,免费快速)
  AGNES_MODEL: "agnes-2.0-flash"
};
